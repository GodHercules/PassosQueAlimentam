generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  email             String         @unique
  passwordHash      String?        @map("password_hash")
  emailConfirmedAt  DateTime?      @map("email_confirmed_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  profile           Profile?
  registrations     Registration[]
  consents          Consent[]
  @@map("users")
}

model Profile {
  id                  String    @id @db.Uuid
  fullName            String    @map("full_name")
  phoneE164           String?   @map("phone_e164")
  sex                 String?
  birthDate           DateTime? @map("birth_date") @db.Date
  avatarPath          String?   @map("avatar_path")
  profileCompletedAt  DateTime? @map("profile_completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  user                User      @relation(fields: [id], references: [id], onDelete: Cascade)
  @@map("profiles")
}

model Event {
  id                   String         @id @default(uuid()) @db.Uuid
  slug                 String         @unique
  name                 String
  eventDate            DateTime       @map("event_date") @db.Date
  location             String
  distanceKm           Decimal        @map("distance_km") @db.Decimal(5, 2)
  status               String         @default("OPEN")
  donationInstructions String         @map("donation_instructions")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  registrations        Registration[]
  @@map("events")
}

model Registration {
  id                String   @id @default(uuid()) @db.Uuid
  protocol          String   @unique
  eventId           String   @map("event_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  referralSource    String   @map("referral_source")
  referrerName      String?  @map("referrer_name")
  shirtSize         String   @map("shirt_size")
  status            String   @default("PRE_REGISTERED")
  submittedAt      DateTime @default(now()) @map("submitted_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([eventId, userId])
  @@index([status])
  @@index([userId])
  @@index([submittedAt])
  @@map("registrations")
}

model Consent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  consentType  String   @map("consent_type")
  version      String
  acceptedAt   DateTime @default(now()) @map("accepted_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, consentType, version])
  @@map("consents")
}
